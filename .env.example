# UI branding defaults. Web settings can override these locally.
E2EBUDDY_UI_PRODUCT_NAME=e2ebuddy
E2EBUDDY_UI_LOGO_PATH=

# Local web runtime
E2EBUDDY_WEB_HOST=127.0.0.1
E2EBUDDY_WEB_PORT=6558

# AI defaults. Web settings can override these locally.
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
AI_AGENT_MODEL=mimo-v2.5-pro
AI_VISION_MODEL=mimo-v2.5
AI_REPORT_MODEL=mimo-v2.5
AI_THINKING=disabled

# Optional Anthropic compatibility
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=
ANTHROPIC_REPORT_MODEL=

# SQLite (path relative to packages/db/prisma/schema.prisma)
# CLI mode does not need a database at all.
DATABASE_URL=file:../data/e2ebuddy.db

# Legacy external worker mode only. The default local Web runtime does not use Redis.
REDIS_URL=

# Storage: local by default; fill S3 values only when using external S3-compatible storage
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=e2ebuddy
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Runtime limits
RUN_TIMEOUT_MS=600000
CASE_STEP_LIMIT=25
RUNS_PER_IP_PER_HOUR=5

# Development-only: permits the CLI to test an exact localhost fixture origin.
E2EBUDDY_ALLOW_PRIVATE_TARGETS=false
