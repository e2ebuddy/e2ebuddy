# Default: any OpenAI-compatible Chat Completions endpoint
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
AI_AGENT_MODEL=mimo-v2.5-pro
AI_VISION_MODEL=mimo-v2.5
AI_REPORT_MODEL=mimo-v2.5
AI_THINKING=disabled

# Optional Anthropic compatibility
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=
ANTHROPIC_REPORT_MODEL=

# Postgres and Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/e2ebuddy
REDIS_URL=redis://localhost:6379

# Storage: local for CLI/development, s3 for deployed environments
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=e2ebuddy
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Runtime limits
RUN_TIMEOUT_MS=600000
CASE_STEP_LIMIT=25
RUNS_PER_IP_PER_HOUR=5

# Development-only: permits the CLI to test an exact localhost fixture origin.
E2EBUDDY_ALLOW_PRIVATE_TARGETS=false
