{
  "name": "e2ebuddy-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "cli": "pnpm -F e2ebuddy cli",
    "demo": "pnpm -F fixture build && pnpm -F fixture start",
    "eval:explore": "node scripts/evaluate-explore.mjs",
    "smoke:local-web": "pnpm --filter e2ebuddy build && pnpm --filter local-web build && node scripts/smoke-local-web.mjs",
    "pack": "node scripts/pack.mjs",
    "pack:mac": "node scripts/pack.mjs --mac",
    "pack:mac:x64": "node scripts/pack.mjs --mac --x64",
    "pack:mac:arm64": "node scripts/pack.mjs --mac --arm64",
    "pack:win": "node scripts/pack.mjs --win",
    "pack:win:x64": "node scripts/pack.mjs --win --x64",
    "pack:win:arm64": "node scripts/pack.mjs --win --arm64",
    "pack:linux": "node scripts/pack.mjs --linux",
    "pack:linux:x64": "node scripts/pack.mjs --linux --x64",
    "pack:linux:arm64": "node scripts/pack.mjs --linux --arm64",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/node": "22.13.4",
    "eslint": "9.20.1",
    "turbo": "2.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vitest": "3.0.5"
  },
  "license": "UNLICENSED",
  "description": "<div align=\"center\">",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git@github-e2ebuddy:e2ebuddy/e2ebuddy.git"
  }
}
