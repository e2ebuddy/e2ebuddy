{
  "name": "executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "playwright": "1.61.1",
    "shared": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "turbo run build --filter=e2ebuddy... && node ../cli/dist/cli.js executor-demo",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  }
}
