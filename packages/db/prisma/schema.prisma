generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TestRun {
  id                    String   @id
  targetUrl             String
  userBrief             String?
  credentialsCiphertext String?
  status                String
  understanding         Json?
  plan                  Json?
  evidence              Json?
  judgement             Json?
  report                Json?
  error                 String?
  metrics               Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status, createdAt])
}
